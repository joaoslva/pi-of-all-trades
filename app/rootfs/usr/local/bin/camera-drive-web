#!/usr/bin/env python3
"""
The phone-facing web UI for camera-drive.

Runs unprivileged as joao. The only privileged things it can do are shell out
to `sudo camera-drive wipe` (which enforces its own safety rule independently) and
`sudo systemctl poweroff`. This app is never trusted to decide what is safe to
delete.

Live view and camera control work by talking to camera-live through a JSON file
in /run/camera-drive. Both processes run as joao, so there is no socket, no
daemon protocol and no privilege boundary to get wrong. This app never opens
/dev/video0 itself; camera-live owns it, because only one process can.

Recordings are MJPEG in Matroska, which no browser can decode. Default playback
unwraps the JPEG frames they already contain and streams them as multipart,
exactly like the live view -- instant, and no re-encoding at all. An <img> has
no audio channel though, so /api/mp4 transcodes on demand and caches the result
for playback with sound and a seek bar. Note that re-encoding is only slow in
the LIVE capture path (a quarter of realtime); from a file the Pi's hardware
encoder manages 3.3x realtime.

Selected videos can also be exported as MP4, MOV, WebM or MP3. Conversion runs
as a background job the page polls, because a long tape takes minutes and a
phone browser will not sit on a silent request that long.

Served by waitress on port 8081; the hub (pihub) owns port 80 and links here.
"""

from __future__ import annotations

import hashlib
import json
import mimetypes
import os
import secrets
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import zipfile
from datetime import datetime
from pathlib import Path

from flask import (Flask, Response, abort, after_this_request, jsonify,
                   request, send_file, send_from_directory)
from PIL import Image

ROOT = Path("/srv/camera-drive")
MEDIA = ROOT / "media"
VIDEO = ROOT / "video"
THUMBS = ROOT / "thumbs"
PROXY = ROOT / "proxy"
TMP = ROOT / "tmp"
STATUS_PATH = ROOT / "status.json"
RECSTATUS_PATH = ROOT / "recstatus.json"
INDEX_PATH = ROOT / "index.json"

RUN = Path("/run/camera-drive")
LIVE_JPG = RUN / "live.jpg"
CONTROL = RUN / "control.json"

SERVE_ROOTS = (MEDIA, VIDEO)
IMAGE_SUFFIXES = {".jpg", ".jpeg", ".png"}
VIDEO_SUFFIXES = {".avi", ".mov", ".mp4", ".mkv"}
THUMB_PX = 320

# JPEG markers. ffmpeg rewrites live.jpg in place many times a second, so a
# reader can catch a half-written file; frames not ending in EOI are dropped
# rather than shown torn. The same markers split the demuxed playback stream.
JPEG_SOI = b"\xff\xd8\xff"
JPEG_EOI = b"\xff\xd9"

# Export formats for videos. Timings are for an 18.6 s tape on this Pi. GIF was
# measured too (45 s, 13MB) and left out; HEVC has no hardware encoder here.
EXPORTS = {
    "mp4": ".mp4",   # H.264 + AAC, hardware encoder, 3.9 s -- the cached proxy
    "mov": ".mov",   # the same streams remuxed, 0.9 s on top of the MP4
    "webm": ".webm", # VP9 + Opus in software, 12 s
    "mp3": ".mp3",   # audio only, 1.8 s
}
EXPORT_TTL = 1800           # seconds a finished export waits to be downloaded
EXPORT_FETCHED_TTL = 300    # and how long it lingers after, for a retry

# One ffmpeg encode at a time. A Zero 2 W has 512MB and one hardware encoder;
# two transcodes side by side only make both slower. It also stops two
# requests for the same clip writing the same .part file.
ENCODE_LOCK = threading.Lock()

app = Flask(__name__)


# --------------------------------------------------------------------------
# data
# --------------------------------------------------------------------------

def read_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return default


def camera_state() -> dict:
    try:
        out = subprocess.run(["lsusb"], capture_output=True, text=True,
                             timeout=5).stdout.lower()
    except (OSError, subprocess.SubprocessError):
        return {"connected": False, "mode": "unknown"}
    if "08ca:2023" in out:
        return {"connected": True, "mode": "storage"}
    if "08ca:2022" in out:
        return {"connected": True, "mode": "live"}
    return {"connected": False, "mode": "none"}


def disk_state() -> dict:
    u = shutil.disk_usage(ROOT)
    return {"total": u.total, "used": u.total - u.free, "free": u.free,
            "pct": round((u.total - u.free) / u.total * 100, 1)}


def _pretty_folder(name: str) -> str:
    if name == "snapshots":
        return "Snapshots"
    try:
        return datetime.strptime(name, "%Y-%m-%d_%H%M%S").strftime("%d %b %Y, %H:%M")
    except ValueError:
        return name


def list_dumps() -> list[dict]:
    dumps = []
    if not MEDIA.exists():
        return dumps
    for folder in sorted(MEDIA.iterdir(), reverse=True):
        # Snapshots were shot through the app, so they live under Captures.
        if not folder.is_dir() or folder.name == "snapshots":
            continue
        items = []
        for f in sorted(folder.iterdir(), reverse=True):
            suffix = f.suffix.lower()
            if suffix not in IMAGE_SUFFIXES | VIDEO_SUFFIXES:
                continue
            rel = f"media/{folder.name}/{f.name}"
            video = suffix in VIDEO_SUFFIXES
            items.append({"name": f.name, "path": rel,
                          "size": f.stat().st_size,
                          "kind": "video" if video else "image",
                          "proxy": video and proxy_path(rel).exists()})
        if items:
            dumps.append({"folder": folder.name,
                          "label": _pretty_folder(folder.name),
                          "count": len(items),
                          "bytes": sum(i["size"] for i in items),
                          "items": items})
    return dumps


def _stamp(name: str) -> str:
    """ "2026-08-17_175004.mkv" and "SNAP_2026-08-17_183539.jpg" both give
    "2026-08-17_175004", so tapes and snapshots sort together."""
    return Path(name).stem.removeprefix("SNAP_")


def list_captures() -> list[dict]:
    """What was shot through the app, tapes and snapshots together, newest
    first and grouped by day. The files stay where camera-live writes them."""
    items = []
    if VIDEO.exists():
        for f in VIDEO.iterdir():
            if f.is_file() and f.suffix.lower() in VIDEO_SUFFIXES:
                rel = f"video/{f.name}"
                items.append({"name": f.name, "path": rel,
                              "size": f.stat().st_size, "kind": "video",
                              "proxy": proxy_path(rel).exists()})
    snaps = MEDIA / "snapshots"
    if snaps.exists():
        for f in snaps.iterdir():
            if f.is_file() and f.suffix.lower() in IMAGE_SUFFIXES:
                items.append({"name": f.name, "path": f"media/snapshots/{f.name}",
                              "size": f.stat().st_size, "kind": "image"})
    items.sort(key=lambda i: _stamp(i["name"]), reverse=True)

    groups: list[dict] = []
    for i in items:
        day = _stamp(i["name"])[:10]
        if not groups or groups[-1]["day"] != day:
            try:
                label = datetime.strptime(day, "%Y-%m-%d").strftime("%d %b %Y")
            except ValueError:
                label = day
            groups.append({"day": day, "label": label, "items": []})
        groups[-1]["items"].append(i)
    return groups


def safe_media_path(rel: str) -> Path:
    """Resolve under one of SERVE_ROOTS or refuse. Paths come from URLs and
    form fields, so this is the only thing between a crafted request and the
    rest of the filesystem."""
    target = (ROOT / rel).resolve()
    for base in SERVE_ROOTS:
        if str(target).startswith(str(base.resolve()) + os.sep):
            break
    else:
        abort(404)
    if not target.is_file():
        abort(404)
    return target


def proxy_path(rel: str) -> Path:
    """Where the cached H.264 copy of a video lives. Tapes are named by
    timestamp and are unique, but camera clips restart at IMG_0001 after every
    format, so those carry their dump folder or they overwrite each other."""
    parts = Path(rel).parts
    if parts[0] == "video":
        return PROXY / (Path(rel).stem + ".mp4")
    return PROXY / ("_".join(parts[1:-1]) + "_" + Path(rel).stem + ".mp4")


def prune_proxies() -> None:
    """Drop cached copies whose source is gone, including the ones cached
    under the old name-only scheme."""
    if not PROXY.exists():
        return
    keep = {proxy_path(f"video/{f.name}") for f in VIDEO.glob("*")
            if f.suffix.lower() in VIDEO_SUFFIXES}
    keep |= {proxy_path(f"media/{f.parent.name}/{f.name}")
             for f in MEDIA.glob("*/*") if f.suffix.lower() in VIDEO_SUFFIXES}
    for p in PROXY.iterdir():
        if p not in keep:
            p.unlink(missing_ok=True)


def archive_names(entries: list[tuple[Path, str]]) -> list[str]:
    """Names inside a zip, from (source file, wanted name) pairs. Camera clips
    from different dumps share names, and a zip holding two IMG_0001.AVI
    silently loses one on extraction, so clashes get the dump folder."""
    names = [n for _, n in entries]
    return [f"{src.parent.name}_{n}" if names.count(n) > 1 else n
            for src, n in entries]


# --------------------------------------------------------------------------
# live view and playback
# --------------------------------------------------------------------------

def read_live_frame() -> bytes | None:
    try:
        data = LIVE_JPG.read_bytes()
    except OSError:
        return None
    if len(data) < 1024 or not data.endswith(JPEG_EOI):
        return None
    return data


def control_update(**kw) -> dict:
    cur = read_json(CONTROL, {"preview": False, "recording": False,
                              "snapshot_seq": 0})
    cur.update(kw)
    RUN.mkdir(parents=True, exist_ok=True)
    tmp = CONTROL.with_suffix(".tmp")
    tmp.write_text(json.dumps(cur))
    os.replace(tmp, CONTROL)
    return cur


def multipart(frame: bytes) -> bytes:
    return (b"--frame\r\nContent-Type: image/jpeg\r\n"
            + f"Content-Length: {len(frame)}\r\n\r\n".encode() + frame + b"\r\n")


def live_stream():
    last, idle = None, 0
    while True:
        frame = read_live_frame()
        if frame and frame != last:
            last, idle = frame, 0
            yield multipart(frame)
        else:
            idle += 1
            # Viewfinder switched off or camera unplugged: end the stream
            # rather than holding a waitress thread open forever.
            if idle > 60:
                return
        time.sleep(0.08)


def play_stream(path: Path):
    """
    Play a recording by unwrapping the JPEG frames it already contains.

    -re paces ffmpeg at the file's native rate so playback runs at real speed,
    and -c:v copy means no decoding or re-encoding happens anywhere.
    """
    proc = subprocess.Popen(
        ["ffmpeg", "-v", "error", "-re", "-i", str(path),
         "-c:v", "copy", "-f", "image2pipe", "-"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)
    buf = b""
    try:
        while True:
            chunk = proc.stdout.read(65536)
            if not chunk:
                break
            buf += chunk
            while True:
                end = buf.find(JPEG_EOI)
                if end == -1:
                    break
                frame, buf = buf[:end + 2], buf[end + 2:]
                start = frame.find(JPEG_SOI)
                if start != -1:
                    yield multipart(frame[start:])
    except GeneratorExit:
        pass
    finally:
        proc.kill()
        proc.wait(timeout=5)


# --------------------------------------------------------------------------
# transcoding
# --------------------------------------------------------------------------

def run_ffmpeg(args: list[str], out: Path, cancelled=lambda: False) -> bool:
    """Run one ffmpeg into `out`. Returns whether it produced a file that
    ffprobe can read, and removes whatever it left behind otherwise."""
    proc = subprocess.Popen(["ffmpeg", "-v", "error", *args, "-y", str(out)],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    while True:
        try:
            proc.wait(timeout=1)
            break
        except subprocess.TimeoutExpired:
            if cancelled():
                proc.kill()
                proc.wait()
                break
    if proc.returncode == 0 and out.exists() and out.stat().st_size > 1024:
        probe = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "csv=p=0", str(out)], capture_output=True, text=True)
        if probe.returncode == 0 and probe.stdout.strip():
            return True
    out.unlink(missing_ok=True)
    return False


def ensure_mp4(src: Path, rel: str, cancelled=lambda: False) -> Path | None:
    """
    The cached H.264 + AAC copy of a video, made on first use.

    h264_v4l2m2m only produced invalid output in the live-capture pipeline,
    where it was paired with fragmented MP4. From a file into a normal
    +faststart MP4 it is fine -- but fall back to libx264 if it ever is not.
    """
    dest = proxy_path(rel)
    if dest.exists():
        return dest
    with ENCODE_LOCK:
        if dest.exists():
            return dest
        PROXY.mkdir(parents=True, exist_ok=True)
        tmp = dest.with_suffix(".part")
        # -f mp4 is REQUIRED, not decorative. ffmpeg picks its muxer from the
        # output file extension, and the ".part" name (used so a half-written
        # transcode is never served) means nothing to it -- without this it
        # fails instantly with "unable to find a suitable output format".
        common = ["-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "96k",
                  "-movflags", "+faststart", "-f", "mp4"]
        for vcodec in (["-c:v", "h264_v4l2m2m", "-b:v", "1500k"],
                       ["-c:v", "libx264", "-preset", "veryfast", "-crf", "26"]):
            if cancelled():
                return None
            if run_ffmpeg(["-i", str(src), *vcodec, *common], tmp, cancelled):
                os.replace(tmp, dest)
                return dest
    return None


def export_video(src: Path, rel: str, fmt: str, workdir: Path,
                 cancelled=lambda: False) -> Path | None:
    """One video in the requested format. MP4 is the shared cache itself; the
    rest are written into the job's own directory."""
    if fmt == "mp4":
        return ensure_mp4(src, rel, cancelled)
    out = workdir / (secrets.token_hex(4) + EXPORTS[fmt])
    if fmt == "mov":
        # Same streams as the MP4, so building on the cache makes this a
        # sub-second remux, and a later MP4 export is free.
        mp4 = ensure_mp4(src, rel, cancelled)
        if not mp4:
            return None
        args = ["-i", str(mp4), "-c", "copy", "-movflags", "+faststart",
                "-f", "mov"]
    elif fmt == "webm":
        # realtime/cpu-used 8 is what keeps VP9 near realtime on four A53s.
        args = ["-i", str(src), "-c:v", "libvpx-vp9", "-deadline", "realtime",
                "-cpu-used", "8", "-row-mt", "1", "-b:v", "1000k",
                "-pix_fmt", "yuv420p", "-c:a", "libopus", "-b:a", "96k",
                "-f", "webm"]
    else:  # mp3
        args = ["-i", str(src), "-vn", "-c:a", "libmp3lame", "-q:a", "3",
                "-f", "mp3"]
    with ENCODE_LOCK:
        return out if run_ffmpeg(args, out, cancelled) else None


# --------------------------------------------------------------------------
# export jobs
# --------------------------------------------------------------------------

JOBS: dict[str, dict] = {}
JOBS_LOCK = threading.Lock()


def job_dir(job_id: str) -> Path:
    return TMP / f"export-{job_id}"


def sweep_jobs() -> None:
    """Forget exports nobody came back for. Tapes run to gigabytes, and this
    is an SD card."""
    now = time.time()
    with JOBS_LOCK:
        for job_id, job in list(JOBS.items()):
            fetched, finished = job.get("fetched"), job.get("finished")
            if ((fetched and now - fetched > EXPORT_FETCHED_TTL)
                    or (finished and now - finished > EXPORT_TTL)):
                del JOBS[job_id]
                shutil.rmtree(job_dir(job_id), ignore_errors=True)


def run_export(job_id: str, items: list[tuple[str, Path]], fmt: str) -> None:
    job = JOBS[job_id]
    workdir = job_dir(job_id)
    workdir.mkdir(parents=True, exist_ok=True)
    cancelled = lambda: job["state"] == "cancelled"
    outputs: list[tuple[Path, Path, str]] = []  # (file, source, name)
    try:
        for n, (rel, src) in enumerate(items):
            if cancelled():
                break
            job.update(done=n, current=src.name)
            if src.suffix.lower() not in VIDEO_SUFFIXES:
                outputs.append((src, src, src.name))
                continue
            out = export_video(src, rel, fmt, workdir, cancelled)
            if out:
                outputs.append((out, src, src.stem + EXPORTS[fmt]))
            elif not cancelled():
                job["failed"].append(src.name)
        if cancelled():
            job["finished"] = time.time()
            shutil.rmtree(workdir, ignore_errors=True)
            return
        job.update(done=len(items), current=None)
        if not outputs:
            job.update(state="error", finished=time.time())
            return
        if len(outputs) == 1:
            path, _, name = outputs[0]
        else:
            path = workdir / "export.zip"
            name = f"camera-drive_{datetime.now():%Y-%m-%d_%H%M}_{fmt}.zip"
            arcs = archive_names([(src, n) for _, src, n in outputs])
            with zipfile.ZipFile(path, "w", zipfile.ZIP_STORED) as z:
                for (f, _, _), arc in zip(outputs, arcs):
                    z.write(f, arcname=arc)
        job.update(state="done", finished=time.time(), path=str(path),
                   name=name, size=path.stat().st_size)
    except Exception as exc:  # the page is polling; tell it rather than hang
        job.update(state="error", error=str(exc), finished=time.time())


# --------------------------------------------------------------------------
# thumbnails
# --------------------------------------------------------------------------

def thumb_for(rel: str) -> Path | None:
    src = safe_media_path(rel)
    key = hashlib.sha256(f"{rel}:{src.stat().st_mtime_ns}".encode()).hexdigest()[:32]
    dest = THUMBS / f"{key}.jpg"
    if dest.exists():
        return dest
    THUMBS.mkdir(parents=True, exist_ok=True)
    suffix = src.suffix.lower()
    try:
        if suffix in IMAGE_SUFFIXES:
            with Image.open(src) as im:
                im = im.convert("RGB")
                im.thumbnail((THUMB_PX, THUMB_PX))
                im.save(dest, "JPEG", quality=80)
        elif suffix in VIDEO_SUFFIXES:
            # Seek in a little: frame 0 is often the lens cap, or a frame the
            # auto-exposure has not settled on yet.
            for args in (["-ss", "1", "-i", str(src)], ["-i", str(src)]):
                subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error",
                                *args, "-frames:v", "1",
                                "-vf", f"scale={THUMB_PX}:-1", "-y", str(dest)],
                               check=False, capture_output=True, timeout=90)
                if dest.exists():
                    break
        else:
            return None
    except Exception:
        return None
    return dest if dest.exists() else None


# --------------------------------------------------------------------------
# routes
# --------------------------------------------------------------------------

@app.get("/api/state")
def api_state():
    return jsonify({
        "camera": camera_state(),
        "disk": disk_state(),
        "status": read_json(STATUS_PATH, {}),
        "recstatus": read_json(RECSTATUS_PATH, {}),
        "control": read_json(CONTROL, {}),
        "live": LIVE_JPG.exists(),
        "held": len(read_json(INDEX_PATH, {})),
        "dumps": list_dumps(),
        "captures": list_captures(),
    })


@app.get("/api/stream")
def api_stream():
    if not LIVE_JPG.exists():
        abort(503)
    return Response(live_stream(),
                    mimetype="multipart/x-mixed-replace; boundary=frame")


@app.get("/api/play/<path:rel>")
def api_play(rel: str):
    path = safe_media_path(rel)
    if path.suffix.lower() not in VIDEO_SUFFIXES:
        abort(400)
    return Response(play_stream(path),
                    mimetype="multipart/x-mixed-replace; boundary=frame")


@app.get("/api/live.jpg")
def api_live_jpg():
    frame = read_live_frame()
    if not frame:
        abort(503)
    return Response(frame, mimetype="image/jpeg",
                    headers={"Cache-Control": "no-store"})


@app.post("/api/control")
def api_control():
    body = request.json or {}
    out = {}
    if "preview" in body:
        out = control_update(preview=bool(body["preview"]))
    if "recording" in body:
        # Recording implies the capture pipeline, so switching it on also
        # turns the viewfinder on rather than fighting with it.
        kw = {"recording": bool(body["recording"])}
        if body["recording"]:
            kw["preview"] = True
        out = control_update(**kw)
    if body.get("snapshot"):
        cur = read_json(CONTROL, {})
        out = control_update(snapshot_seq=int(cur.get("snapshot_seq", 0)) + 1)
    if not out:
        return jsonify({"ok": False, "error": "nothing to do"}), 400
    return jsonify({"ok": True, "control": out})


@app.post("/api/power")
def api_power():
    """Shut the Pi down cleanly. Pulling the plug on a running Pi is the
    reliable way to corrupt an SD card eventually."""
    try:
        # Fire and forget: systemd takes a few seconds to actually halt, which
        # is long enough for this response to reach the phone.
        subprocess.Popen(["sudo", "-n", "systemctl", "poweroff"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as exc:
        return jsonify({"ok": False, "error": str(exc)}), 500
    return jsonify({"ok": True})


@app.get("/api/mp4/<path:rel>")
def api_mp4(rel: str):
    """
    An H.264 + AAC copy of a recording, so it plays in a real <video> element
    with sound and a seek bar. Transcoded once on demand, then cached.

    The in-app MJPEG preview stays the default because it is instant and free;
    this is the "I want the audio" path. Measured on this Pi: the hardware
    encoder does 3.3x realtime, so a one minute clip takes about 18 seconds.
    """
    src = safe_media_path(rel)
    if src.suffix.lower() not in VIDEO_SUFFIXES:
        abort(400)
    dest = ensure_mp4(src, rel)
    if not dest:
        abort(500)
    # conditional=True gives range requests, which is what makes seeking work.
    return send_file(dest, mimetype="video/mp4", conditional=True)


@app.post("/api/export")
def api_export():
    """Start converting a selection. Photos in it are passed through as they
    are; videos become `format`. Returns a job id to poll."""
    body = request.json or {}
    fmt = body.get("format")
    rels = body.get("paths") or []
    if fmt not in EXPORTS or not isinstance(rels, list) or not rels:
        abort(400)
    items = [(str(r), safe_media_path(str(r))) for r in rels[:500]]
    sweep_jobs()
    job_id = secrets.token_hex(8)
    with JOBS_LOCK:
        JOBS[job_id] = {"state": "running", "format": fmt, "done": 0,
                        "total": len(items), "current": None, "failed": []}
    threading.Thread(target=run_export, args=(job_id, items, fmt),
                     daemon=True).start()
    return jsonify({"ok": True, "id": job_id})


def get_job(job_id: str) -> dict:
    job = JOBS.get(job_id)
    if not job:
        abort(404)
    return job


@app.get("/api/export/<job_id>")
def api_export_status(job_id: str):
    job = get_job(job_id)
    return jsonify({k: job.get(k) for k in
                    ("state", "done", "total", "current", "failed", "name",
                     "size", "error")})


@app.delete("/api/export/<job_id>")
def api_export_cancel(job_id: str):
    job = get_job(job_id)
    if job["state"] == "running":
        job["state"] = "cancelled"
    else:
        with JOBS_LOCK:
            JOBS.pop(job_id, None)
        shutil.rmtree(job_dir(job_id), ignore_errors=True)
    return jsonify({"ok": True})


@app.get("/api/export/<job_id>/file")
def api_export_file(job_id: str):
    job = get_job(job_id)
    if job["state"] != "done":
        abort(409)
    # Kept a few minutes after the first fetch, so an interrupted download
    # on a phone can simply be retried.
    job.setdefault("fetched", time.time())
    path = Path(job["path"])
    mime, _ = mimetypes.guess_type(job["name"])
    return send_file(path, mimetype=mime or "application/octet-stream",
                     as_attachment=True, download_name=job["name"],
                     conditional=True)


@app.get("/media/<path:rel>")
def media(rel: str):
    path = safe_media_path(rel)
    mime, _ = mimetypes.guess_type(path.name)
    # Browsers cannot decode MJPEG/Matroska, and left to themselves they show
    # a bare "no supported source" error. Send video as a download instead;
    # in-app playback goes through /api/play.
    as_attach = path.suffix.lower() in VIDEO_SUFFIXES or "dl" in request.args
    return send_file(path, mimetype=mime or "application/octet-stream",
                     conditional=True, as_attachment=as_attach,
                     download_name=path.name if as_attach else None)


@app.get("/thumb/<path:rel>")
def thumb(rel: str):
    t = thumb_for(rel)
    if not t:
        abort(404)
    return send_from_directory(t.parent, t.name, mimetype="image/jpeg",
                               max_age=86400)


@app.post("/api/zip")
def api_zip():
    """
    Bundle the selected files. Submitted as a normal form so the browser
    handles the download itself instead of buffering a blob in phone memory.

    ZIP_STORED, not DEFLATE: JPEG and MJPEG are already compressed, so
    deflating them burns CPU on a Zero 2 W to save almost nothing.
    """
    rels = request.form.getlist("path")
    if not rels:
        abort(400)
    paths = [safe_media_path(r) for r in rels[:500]]

    TMP.mkdir(parents=True, exist_ok=True)
    fd, tmpname = tempfile.mkstemp(suffix=".zip", dir=TMP)
    os.close(fd)
    tmppath = Path(tmpname)

    with zipfile.ZipFile(tmppath, "w", zipfile.ZIP_STORED) as z:
        for p, arc in zip(paths, archive_names([(p, p.name) for p in paths])):
            z.write(p, arcname=arc)

    @after_this_request
    def cleanup(response):
        try:
            tmppath.unlink(missing_ok=True)
        except OSError:
            pass
        return response

    stamp = datetime.now().strftime("%Y-%m-%d_%H%M")
    return send_file(tmppath, mimetype="application/zip", as_attachment=True,
                     download_name=f"camera-drive_{stamp}.zip")


@app.post("/api/wipe")
def api_wipe():
    commit = bool(request.json and request.json.get("commit"))
    flag = "--commit" if commit else "--dry-run"
    try:
        res = subprocess.run(["sudo", "-n", "/usr/local/bin/camera-drive", "wipe", flag],
                             capture_output=True, text=True, timeout=900)
    except subprocess.SubprocessError as exc:
        return jsonify({"ok": False, "errors": [str(exc)]}), 500
    try:
        payload = json.loads(res.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return jsonify({"ok": False,
                        "errors": ["could not parse camera-drive wipe output",
                                   res.stdout[-400:], res.stderr[-400:]]}), 500
    return jsonify(payload)


@app.get("/")
def index() -> Response:
    return Response(PAGE, mimetype="text/html")


