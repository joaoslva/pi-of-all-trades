<script>
const fmt=b=>b>=1073741824?(b/1073741824).toFixed(1)+'G':b>=1048576?(b/1048576).toFixed(1)+'M'
   :b>=1024?(b/1024).toFixed(0)+'K':b+'B';
// Fills by space REMAINING, matching the "free" figure beside it.
const bar=f=>{const n=16,on=Math.max(0,Math.min(n,Math.round(f/100*n)));
  return '<b>'+'█'.repeat(on)+'</b>'+'░'.repeat(n-on);};

let state=null, tab='live', streaming=false;
let selMode=null, sel=new Set(), lbList=[], lbIdx=0;

// localStorage can throw (private windows); these are conveniences only.
const store={get:k=>{try{return localStorage.getItem(k);}catch(e){return null;}},
             set:(k,v)=>{try{localStorage.setItem(k,v);}catch(e){}}};

// What each gallery tab shows: all, image or video. Disk keeps the key it
// had before Captures existed.
const filterKey={disk:'cd-filter',caps:'cd-filter-caps'};
const filters={};
for(const t in filterKey){ const v=store.get(filterKey[t]);
  filters[t]=['all','image','video'].includes(v)?v:'all'; }

const FORMATS=[
  ['original','Original','as recorded, MJPEG; plays in VLC'],
  ['mp4','MP4 · H.264','plays anywhere; hardware encoded, fast'],
  ['mov','MOV · H.264','for iMovie / Final Cut; same as MP4 inside'],
  ['webm','WebM · VP9','smaller, for the web; about 3x slower'],
  ['mp3','MP3','sound only'],
];
let exportFmt=FORMATS.some(f=>f[0]===store.get('cd-fmt'))?store.get('cd-fmt'):'original';

/* ---------- theme ---------- */
const savedTheme=store.get('cd-theme');
if(savedTheme) document.documentElement.dataset.theme=savedTheme;
document.getElementById('theme').onclick=()=>{
  const cur=document.documentElement.dataset.theme
    || (matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');
  const next=cur==='dark'?'light':'dark';
  document.documentElement.dataset.theme=next;
  store.set('cd-theme',next);
};

/* ---------- tabs ---------- */
document.querySelectorAll('nav button').forEach(b=>{
  b.onclick=()=>{
    tab=b.dataset.tab; exitSelect();
    document.querySelectorAll('nav button').forEach(x=>
      x.setAttribute('aria-selected',String(x===b)));
    document.getElementById('tab-live').hidden=tab!=='live';
    document.getElementById('tab-disk').hidden=tab!=='disk';
    document.getElementById('tab-caps').hidden=tab!=='caps';
    syncStream();
  };
});

/* ---------- live view ---------- */
function syncStream(){
  const v=document.getElementById('viewer');
  const want=(tab==='live'&&state&&state.camera.mode==='live'&&state.live);
  if(want&&!streaming){
    v.innerHTML='<img id="liveimg" alt="live view">';
    const im=document.getElementById('liveimg');
    im.src='/api/stream?t='+Date.now();
    im.onerror=()=>{streaming=false;};
    streaming=true;
  }else if(!want&&streaming){
    v.innerHTML='<div class="off"></div>'; streaming=false;
  }
  if(!streaming&&tab==='live'){
    const off=v.querySelector('.off'); if(!off) return;
    off.innerHTML = !state ? 'connecting...'
      : state.camera.mode==='storage'
        ? 'Camera is in STORAGE mode.<br>Everything offloads automatically.<br><br>Switch it to LIVE for the viewfinder.'
      : state.camera.mode!=='live'
        ? 'No camera connected.<br><br>Plug it in as <code>live</code><br>to use the viewfinder.'
      : 'Viewfinder is off.<br>The camera sensor is idle.<br><br>Press <b>Viewfinder</b> to wake it.';
  }
}

async function refresh(){
  try{ state=await (await fetch('/api/state',{cache:'no-store'})).json(); }catch(e){ return; }
  const c=state.camera,r=state.recstatus||{},s=state.status||{},ctl=state.control||{};

  const cam=document.getElementById('cam');
  cam.textContent='camera: '+(c.mode==='storage'?'storage':c.mode==='live'?'live':'none');
  cam.className='pill '+(c.mode==='storage'?'on':c.mode==='live'?'live':'');

  const last=document.getElementById('last');
  if(r.recording){last.innerHTML='<i class="reclamp"></i>rec '+(r.file||'');last.className='pill rec';}
  else if(s.state==='copying'){last.textContent='copying '+(s.done||0)+'/'+(s.total||0);last.className='pill live';}
  else {last.textContent=s.last_result||'idle';last.className='pill';}

  const d=state.disk;
  document.getElementById('gauge').innerHTML=bar(100-d.pct)+' '+fmt(d.free)+' free';
  document.getElementById('held').textContent=state.held+' held';

  const isLive=c.mode==='live', on=!!ctl.preview, ready=isLive&&state.live;
  const vf=document.getElementById('vf');
  vf.disabled=!isLive;
  vf.textContent=on?'■ Viewfinder':'▶ Viewfinder';
  vf.className='btn '+(on?'stop':'');
  document.getElementById('shoot').disabled=!ready;
  document.getElementById('rec').disabled=!isLive;
  const rb=document.getElementById('rec');
  rb.textContent=r.recording?'■ Stop':'⏺ Record';
  rb.className='btn '+(r.recording?'stop':'rec');
  document.getElementById('livehint').textContent =
    r.recording?'recording to '+(r.file||'')+' — unplugging also stops it cleanly'
    : ready?'shoot saves the camera’s own frame to Captures, no re-encoding'
    : isLive?'sensor idle — nothing is being captured'
    : '';

  document.getElementById('wipe').disabled=(c.mode!=='storage');
  render(); syncStream();
}

/* ---------- grids ---------- */
function cell(i,idx,listName){
  return '<a class="cell'+(sel.has(i.path)?' sel':'')+'" data-path="'+i.path
   +'" data-list="'+listName+'" data-idx="'+idx+'">'
   +'<img loading="lazy" src="/thumb/'+encodeURI(i.path)+'" alt="">'
   +(selMode?'<span class="tick">✓</span>':'')
   +'<span class="badge">'+(i.kind==='video'?'▶':'')+fmt(i.size)+'</span></a>';
}

// Both gallery tabs are day or dump groups of items, drawn the same way.
const groupsOf=t=>t==='disk'?state.dumps:state.captures;
const shown=t=>i=>filters[t]==='all'||i.kind===filters[t];
function flat(t){ return groupsOf(t).flatMap(g=>g.items.filter(shown(t))); }

const EMPTY={
  disk:'Nothing offloaded yet.<br>Plug the camera in as <code>storage</code>.',
  caps:'Nothing captured yet.<br>Plug the camera in as <code>live</code>,<br>then Shoot or Record.',
};
function renderTab(t){
  const all=groupsOf(t).flatMap(g=>g.items);
  const n={all:all.length,image:all.filter(i=>i.kind==='image').length,
           video:all.filter(i=>i.kind==='video').length};
  document.querySelectorAll('[data-filter="'+t+'"] button').forEach(b=>{
    b.setAttribute('aria-pressed',String(b.dataset.f===filters[t]));
    b.textContent={all:'All',image:'Photos',video:'Videos'}[b.dataset.f]+' '+n[b.dataset.f];
  });
  let k=0;
  const secs=groupsOf(t).map(g=>{
    const items=g.items.filter(shown(t)); if(!items.length) return '';
    const cells=items.map(i=>cell(i,k++,t)).join('');
    return '<section><h2>'+g.label+' <span>'+items.length+' / '
      +fmt(items.reduce((a,i)=>a+i.size,0))+'</span></h2>'
      +'<div class="grid">'+cells+'</div></section>';
  }).join('');
  document.getElementById(t).innerHTML=secs
   || '<div class="empty">'+(all.length?'No '+(filters[t]==='image'?'photos':'videos')
        +' here.':EMPTY[t])+'</div>';
}

function render(){
  renderTab('disk'); renderTab('caps');
  document.querySelectorAll('.cell').forEach(el=>{
    el.onclick=ev=>{
      ev.preventDefault();
      const p=el.dataset.path;
      if(selMode){
        sel.has(p)?sel.delete(p):sel.add(p);
        el.classList.toggle('sel'); updateSelBar(); return;
      }
      openLb(flat(el.dataset.list),parseInt(el.dataset.idx,10));
    };
  });
}

document.querySelectorAll('[data-filter] button').forEach(b=>{
  b.onclick=()=>{
    const t=b.parentElement.dataset.filter;
    filters[t]=b.dataset.f; store.set(filterKey[t],filters[t]);
    // Never download something the filter is hiding.
    if(selMode===t){ const vis=new Set(flat(t).map(i=>i.path));
      sel.forEach(p=>{ if(!vis.has(p)) sel.delete(p); }); updateSelBar(); }
    render();
  };
});

/* ---------- selection ---------- */
document.querySelectorAll('[data-select]').forEach(b=>{
  b.onclick=()=>{ selMode=b.dataset.select; sel.clear(); render(); updateSelBar(); };
});
function exitSelect(){ selMode=null; sel.clear(); updateSelBar(); if(state) render(); }
const selfmt=document.getElementById('selfmt');
selfmt.innerHTML=FORMATS.map(f=>'<option value="'+f[0]+'">'+f[1]+'</option>').join('');
selfmt.value=exportFmt;
selfmt.onchange=()=>{ exportFmt=selfmt.value; store.set('cd-fmt',exportFmt); updateSelBar(); };

const isVideoPath=p=>[...state.dumps,...state.captures].flatMap(g=>g.items)
  .some(i=>i.path===p&&i.kind==='video');
function updateSelBar(){
  const ab=document.getElementById('actionbar');
  ab.hidden=!selMode;
  document.body.classList.toggle('selecting',!!selMode);
  document.getElementById('selcount').textContent=sel.size+' selected';
  const hasVideo=!!state&&[...sel].some(isVideoPath);
  document.getElementById('selfmtwrap').hidden=!hasVideo;
  const converting=hasVideo&&exportFmt!=='original';
  const b=document.getElementById('seldl');
  b.disabled=sel.size===0;
  b.textContent=sel.size>1?'Download .zip':'Download';
  if(converting) b.textContent=sel.size>1?'Convert .zip':'Convert';
}
document.getElementById('selcancel').onclick=exitSelect;
document.getElementById('seldl').onclick=()=>{
  if(!sel.size) return;
  const paths=[...sel];
  if(exportFmt!=='original'&&paths.some(isVideoPath)){
    runExport(paths,exportFmt); exitSelect(); return;
  }
  if(paths.length===1){
    location.href='/media/'+encodeURI(paths[0])+'?dl=1'; exitSelect(); return;
  }
  // A real form post, so the browser streams the download itself rather than
  // buffering the whole zip in phone memory.
  const f=document.createElement('form');
  f.method='POST'; f.action='/api/zip'; f.style.display='none';
  paths.forEach(p=>{ const i=document.createElement('input');
    i.type='hidden'; i.name='path'; i.value=p; f.appendChild(i); });
  document.body.appendChild(f); f.submit();
  setTimeout(()=>{ f.remove(); exitSelect(); },800);
};

/* ---------- export ---------- */
// Conversion runs server-side as a job this polls, because a long tape takes
// minutes and a phone will not hold a silent request open that long.
async function runExport(paths,format){
  openDlg('Export · '+FORMATS.find(f=>f[0]===format)[1],true);
  dlgBody.innerHTML='Starting...';
  let r;
  try{
    r=await (await fetch('/api/export',{method:'POST',
      headers:{'Content-Type':'application/json'},body:JSON.stringify({paths,format})})).json();
  }catch(e){ r={}; }
  if(!r.id){ dlgBody.innerHTML='<b style="color:var(--red)">Could not start the export.</b>'; return; }
  let live=true;
  onDlgClose=()=>{ live=false; fetch('/api/export/'+r.id,{method:'DELETE'}); };
  const tick=async()=>{
    if(!live) return;
    let j;
    try{ j=await (await fetch('/api/export/'+r.id,{cache:'no-store'})).json(); }
    catch(e){ return setTimeout(tick,1500); }
    const failed=j.failed&&j.failed.length?'<p style="color:var(--orange)">Could not convert: '
      +j.failed.join(', ')+'</p>':'';
    if(j.state==='running'){
      dlgBody.innerHTML='<b>Converting '+Math.min(j.done+1,j.total)+' of '+j.total+'</b>'
        +'<div class="muted" style="margin-top:6px">'+(j.current||'')+'</div>'
        +'<div class="gauge" style="margin-top:8px">'+bar(j.done/j.total*100)+'</div>'
        +failed+'<p class="muted">Runs on the Pi, a few times faster than the clips are long. '
        +'Cancel stops it.</p>';
      return setTimeout(tick,1000);
    }
    if(j.state==='done'){
      const url='/api/export/'+r.id+'/file';
      // Done: closing now only dismisses, the file stays briefly for retries.
      onDlgClose=null;
      dlgBody.innerHTML='<b style="color:var(--green)">Ready · '+j.name+' · '+fmt(j.size)+'</b>'
        +failed+'<p class="muted">Download starting. If it does not, '
        +'<a href="'+url+'" style="color:var(--orange)">tap here</a>.</p>';
      document.getElementById('cancel').textContent='Close';
      location.href=url;
      return;
    }
    onDlgClose=null;
    dlgBody.innerHTML='<b style="color:var(--red)">Export failed.</b>'+failed
      +(j.error?'<div class="muted">'+j.error+'</div>':'');
  };
  tick();
}

/* ---------- lightbox ---------- */
const lb=document.getElementById('lb');
function openLb(list,idx){ lbList=list; lbIdx=idx; lb.hidden=false; showLb(); }
function closeLb(){ lb.hidden=true; document.getElementById('lbstage').innerHTML=''; }
function showLb(){
  const it=lbList[lbIdx]; if(!it) return closeLb();
  document.getElementById('lbname').textContent=it.name;
  document.getElementById('lbcount').textContent=(lbIdx+1)+' / '+lbList.length;
  // Video plays by unwrapping its JPEG frames server-side, so an <img> is the
  // right element for both cases -- no <video>, no codec support needed.
  const src=it.kind==='video'?'/api/play/'+encodeURI(it.path)+'?t='+Date.now()
                             :'/media/'+encodeURI(it.path);
  document.getElementById('lbstage').innerHTML='<img alt="'+it.name+'" src="'+src+'">';
  document.getElementById('lbdl').onclick=()=>it.kind==='video'?saveAs(it)
    :location.href='/media/'+encodeURI(it.path)+'?dl=1';
  // Sound needs a real <video>, which needs H.264. Offered rather than
  // automatic, because the first play of a clip has to transcode it.
  const sb=document.getElementById('lbsound');
  sb.hidden = it.kind!=='video';
  sb.textContent = it.proxy ? '♪ Sound' : '♪ Sound…';
}

document.getElementById('lbsound').onclick=()=>{
  const it=lbList[lbIdx]; if(!it) return;
  const stage=document.getElementById('lbstage');
  stage.innerHTML='<div class="lbnote" id="lbnote">'
    +(it.proxy?'Loading…'
      :'Converting for sound…<br>runs about 3x faster than the clip is long,<br>and only happens once per recording.')
    +'</div>';
  const v=document.createElement('video');
  v.controls=true; v.autoplay=true; v.playsInline=true; v.style.display='none';
  v.src='/api/mp4/'+encodeURI(it.path);
  v.onloadeddata=()=>{ const n=document.getElementById('lbnote'); if(n) n.remove();
                       v.style.display='block'; v.play().catch(()=>{}); };
  v.onerror=()=>{ stage.innerHTML='<div class="lbnote">Could not convert this clip.<br>'
                  +'Use <b>Save</b> and play it in VLC.</div>'; };
  stage.appendChild(v);
}
// Saving a single video asks which format, with the last choice preselected.
function saveAs(it){
  openDlg('Save video',true);
  dlgBody.innerHTML='<b>'+it.name+'</b><div class="fmtlist">'+FORMATS.map(f=>
    '<label><input type="radio" name="fmt" value="'+f[0]+'"'+(f[0]===exportFmt?' checked':'')+'>'
    +'<span>'+f[1]+'<br><small>'+f[2]+'</small></span></label>').join('')+'</div>';
  confirmBtn.hidden=false; confirmBtn.textContent='Save'; confirmBtn.className='btn small shoot';
  confirmBtn.onclick=()=>{
    exportFmt=dlgBody.querySelector('input[name=fmt]:checked').value;
    store.set('cd-fmt',exportFmt); selfmt.value=exportFmt;
    confirmBtn.hidden=true;
    if(exportFmt==='original'){ dlg.close(); location.href='/media/'+encodeURI(it.path)+'?dl=1'; }
    else runExport([it.path],exportFmt);
  };
}
document.getElementById('lbclose').onclick=closeLb;
document.getElementById('lbprev').onclick=()=>{ lbIdx=(lbIdx-1+lbList.length)%lbList.length; showLb(); };
document.getElementById('lbnext').onclick=()=>{ lbIdx=(lbIdx+1)%lbList.length; showLb(); };
addEventListener('keydown',e=>{
  if(lb.hidden) return;
  if(e.key==='Escape') closeLb();
  if(e.key==='ArrowLeft') document.getElementById('lbprev').click();
  if(e.key==='ArrowRight') document.getElementById('lbnext').click();
});

/* ---------- camera control ---------- */
async function control(body){
