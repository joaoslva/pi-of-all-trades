[Unit]
Description=pihub landing page and service manager
After=network.target

[Service]
Type=simple
User=joao
Group=joao
ExecStart=/usr/local/bin/pihub --listen :80 --services-dir /etc/pihub/services.d
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
